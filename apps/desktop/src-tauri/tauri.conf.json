{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slop AI",
  "version": "0.1.0",
  "identifier": "ai.slop.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Slop AI",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; media-src 'self' asset: blob:; connect-src 'self' http://localhost:* https://*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "deb", "rpm", "appimage", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Video",
    "shortDescription": "Local-first prompt-driven rough-cut video editor",
    "longDescription": "Slop AI is an open-source desktop app that turns raw footage and a one-line prompt into a rough-cut timeline you can refine and export to OTIO, Premiere, Resolve, or Kdenlive."
  }
}

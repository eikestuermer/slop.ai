{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the Slop AI desktop app.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:event:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:scope",
      "allow": ["$HOME/**", "$DOCUMENT/**", "$DESKTOP/**", "$VIDEOS/**"]
    }
  ]
}

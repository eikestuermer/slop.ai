{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/schema-codegen-reminder.sh",
        "matcher": "Write|TabWrite"
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/pre-shell-cargo-publish-gate.sh",
        "matcher": "(?:^|[\\s;&|])cargo\\s+(publish|yank)\\b",
        "failClosed": true
      }
    ]
  }
}
